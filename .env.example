# ==============================================================================
# AEVORA — AI-Enabled Evolution & Versioned Organizational Record Architecture
# Environment Configuration Template
# ==============================================================================

# Server Network Configuration
PORT=3001
NODE_ENV=development
EVENTS_DB_PATH=events.db

# ------------------------------------------------------------------------------
# Google Gemini API
# Server-side temporal feature extraction, schema-validated document understanding & QA
# Obtain from Google AI Studio: https://aistudio.google.com/
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# Firebase Authentication & Cloud Datastore (Optional / Production)
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ------------------------------------------------------------------------------
# GitHub Integration & Webhook Ingestion
# ------------------------------------------------------------------------------
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=

# ------------------------------------------------------------------------------
# Atlassian Jira Integration (OAuth 2.0 3LO)
# ------------------------------------------------------------------------------
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_REDIRECT_URI=http://localhost:3001/api/integrations/jira/callback

# ------------------------------------------------------------------------------
# Google Drive Integration (Google Workspace Service Account or OAuth 2.0)
# ------------------------------------------------------------------------------
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=
